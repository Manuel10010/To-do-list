# 📝 FUNCIÓN PARA AÑADIR UNA TAREA
def agregar():
    global color_seleccionado_actual, mis_tareas
    texto = entry_a.get("1.0", tk.END).strip()
    if texto:
        # 📅 Obtenemos la fecha y hora actual exacta
        fecha_actual = datetime.now().strftime("%Y-%m-%d %H:%M")

        lista.insert(tk.END, texto)
        lista.itemconfig(tk.END, fg=color_seleccionado_actual)

        # Guardamos el paquete de datos en la lista maestra incluyendo "completada"
        mis_tareas.append({
            "texto": texto,
            "color": color_seleccionado_actual,
            "fecha": fecha_actual,
            "prioridad": prioridad_seleccionada_actual,
            "completada": False
        })

        label_resultado.config(text="Se añadió la tarea", fg="black")
        entry_a.delete("1.0", tk.END)

        # Auto-guardar tras añadir
        guardar_tareas()
    else:
        messagebox.showerror("Error", "No hay nada que añadir")


# 🗑️ FUNCIÓN PARA BORRAR UNA TAREA
def borrar():
    global mis_tareas
    indice = lista.curselection()
    if indice:
        idx = indice[0]
        lista.delete(idx)
        mis_tareas.pop(idx)  # Borramos también de la lista maestra
        label_resultado.config(text="Se borró la tarea", fg="black")

        # Auto-guardar tras borrar
        guardar_tareas()
    else:
        messagebox.showerror("Error", "Seleccione un elemento para borrar")


# 🗑️ FUNCIÓN PARA BORRAR TODAS LAS TAREAS
def borrar_todo():
    global mis_tareas
    if lista.size() == 0:
        messagebox.showerror("Error", "La lista está vacía")
    else:
        lista.delete(0, tk.END)
        mis_tareas = []  # Vaciamos la lista maestra
        label_resultado.config(text="Se borraron todas las tareas", fg="black")

        # Auto-guardar tras borrar todo
        guardar_tareas()

