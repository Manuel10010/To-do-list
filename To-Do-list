#FUNCIÓN PARA MOSTRAR LA INFORMACIÓN DE LA TAREA
def informacion_tarea():
    indice = lista.curselection()
    if indice:
        idx = indice[0]
        tarea = mis_tareas[idx]

        texto = tarea.get("texto", "Sin texto")
        color = tarea.get("color", "Sin color")
        fecha = tarea.get("fecha", "Sin fecha")
        prioridad = tarea.get("prioridad", "Sin prioridad")
        
        estado_texto = "Sí ✅ (Completada)" if tarea.get("completada", False) else "No ❌ (En progreso)"

        messagebox.showinfo(
            "Información de la tarea", 
            f"📝 Texto: {texto}\n🎨 Color: {color}\n📅 Fecha: {fecha}\n⭐ Prioridad: {prioridad}\n✨ Completada: {estado_texto}"
        )
    else:
        messagebox.showerror("Error", "Seleccione un elemento para ver la información")


# Función para mostrar y cambiar el estado de la tarea (Doble clic o botón)
def Estado_Tarea(event=None):
    global mis_tareas
    indice = lista.curselection()
    if indice: 
        idx = indice[0]
        tarea = mis_tareas[idx]

        # Invertimos el estado actual
        estado_actual = tarea.get("completada", False)
        nuevo_estado = not estado_actual
        tarea['completada'] = nuevo_estado

        if nuevo_estado:
            lista.itemconfig(idx, fg="gray")
            label_resultado.config(text="¡Tarea completada!", fg="green")
            messagebox.showinfo("Estado de la tarea", "Tarea completada ✅")
        else:
            color_original = tarea.get("color", "black")
            lista.itemconfig(idx, fg=color_original)
            label_resultado.config(text="Tarea en progreso", fg="red")
            messagebox.showinfo("Estado de la tarea", "Tarea en progreso ⏳")

        # Guardamos los cambios automáticamente
        guardar_tareas()
    else:
        messagebox.showerror("Error", "Seleccione un elemento para ver el estado")

        

# Función para cerrar la ventana
