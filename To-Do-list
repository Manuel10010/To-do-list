import json # Para guardar y cargar datos
import os # Para comprobar si existe un archivo
import tkinter as tk # Para crear la interfaz
from tkinter import messagebox, ttk # Para mostrar mensajes
from datetime import datetime # Para obtener la fecha y hora


# Archivo donde se guardarán las tareas
ARCHIVO_DATOS = "tareas.json" # Nombre del archivo donde se guardarán las tareas

color_seleccionado_actual = "black" # Color por defecto

estado_seleccionado_actual = "Sin estado"

# 🧠 Lista maestra global para el Camino B
mis_tareas = []


# 💾 FUNCIÓN PARA GUARDAR DATOS EN EL ARCHIVO
def guardar_tareas():
    with open(ARCHIVO_DATOS, "w", encoding="utf-8") as f:
        json.dump(mis_tareas, f, ensure_ascii=False, indent=4)


# 📂 FUNCIÓN PARA CARGAR DATOS AL ABRIR LA APP
def cargar_tareas():
    global mis_tareas
    if os.path.exists(ARCHIVO_DATOS):
        with open(ARCHIVO_DATOS, "r", encoding="utf-8") as f:
            try:
                mis_tareas = json.load(f)
                for item in mis_tareas:
                    lista.insert(tk.END, item["texto"])
                    if item.get("completada", False):
                        lista.itemconfig(tk.END, fg="gray")
                    else:
                        lista.itemconfig(tk.END, fg=item.get("color", "black"))
            except Exception:
                pass  # Si el archivo está corrupto o vacío, continua normalmente


